# Copy this file to .env and fill in the values from your CognoDB Cloud console.
# console.cognodb.com -> your instance -> Connection details

COGNODB_URI=bolt+s://<your-instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=<your-generated-password>

# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your deployed frontend URL).
# Use * only for local development.
CORS_ORIGIN=*
